# Points at the Firebase Emulator with the offline `demo-app` project id, so
# local dev works before any Firebase project exists. Copy to .env: `cp .env.example .env`.
VITE_API_URL=http://127.0.0.1:5001/demo-app/us-east5/api

# Firebase client config — leave blank for local dev (the app auto-connects to
# the Auth + Firestore emulators). Fill these in for production builds only.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Product analytics (PostHog) — leave unset and analytics stays dormant:
# nothing loads, nothing is sent (in dev, events log to the browser console
# via console.debug instead). Set the project API key to enable.
# VITE_POSTHOG_KEY=
# Optional PostHog host for EU cloud / self-hosted; defaults to the US cloud.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
