# REFERENCE ONLY — the firestore-send-email ("Trigger Email from Firestore")
# extension instance is CONSOLE-MANAGED in prod: it was installed and
# configured through the Firebase console, and firebase.json deliberately has
# NO "extensions" block (a manifest block would make `firebase deploy` try to
# reconcile the live instance against this file and could clobber its SMTP
# config). To move it into the repo later, run `firebase ext:export` against
# the prod project — it writes the manifest + real params itself.
#
# PRODUCTION ONLY. Local dev never needs this: without the extension, `mail`
# docs simply accumulate in the Firestore emulator (inspect them at
# http://localhost:4000/firestore), which is exactly what the tests assert on.

# SMTP connection URI — set in the console instance; the password lives in the
# extension's SMTP_PASSWORD secret (Secret Manager), never in a file.
SMTP_CONNECTION_URI=CONSOLE_MANAGED

# Collection the extension watches for queued messages. MUST stay `mail` —
# functions/src/helpers/mail.ts writes there, and firestore.rules leaves it
# with no match block (default deny) so clients can never queue email.
MAIL_COLLECTION=mail

# From address — must be a sender the SMTP provider allows (a verified
# sending domain/address on the provider account).
DEFAULT_FROM=Pasdiu <info@pasdiu.com>

# Cloud Functions location for the extension's trigger.
LOCATION=us-east5
