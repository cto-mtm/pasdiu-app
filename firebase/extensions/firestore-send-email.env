# Params for the firestore-send-email extension instance declared in
# firebase.json ("extensions": { "firestore-send-email": ... }). The CLI reads
# this file on `firebase deploy --only extensions` (and `firebase ext:install
# firebase/firestore-send-email` can [re]generate it interactively). Param
# names below are the extension's standard ones — if a version bump renames
# any, run `firebase ext:configure firestore-send-email` to regenerate.
#
# PRODUCTION ONLY. Local dev never needs this: without the extension, `mail`
# docs simply accumulate in the Firestore emulator (inspect them at
# http://localhost:4000/firestore), which is exactly what the tests assert on.

# SMTP connection URI — e.g. Resend, SES, or Gmail:
#   smtps://resend:<API_KEY>@smtp.resend.com:465
#   smtps://<user>:<password>@email-smtp.us-east-1.amazonaws.com:465
#   smtps://<user>@gmail.com:<app-password>@smtp.gmail.com:465
# Prefer putting the password in the SMTP_PASSWORD secret and referencing it
# in the URI as a placeholder — see the extension's docs.
SMTP_CONNECTION_URI=REPLACE_ME

# Collection the extension watches for queued messages. MUST stay `mail` —
# functions/src/helpers/mail.ts writes there, and firestore.rules leaves it
# with no match block (default deny) so clients can never queue email.
MAIL_COLLECTION=mail

# From address, e.g. "Pasdiu <invites@yourdomain.com>" (must be a sender the
# SMTP provider allows).
DEFAULT_FROM=REPLACE_ME

# Cloud Functions location for the extension's trigger.
LOCATION=us-east5
