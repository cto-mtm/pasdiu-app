# Stripe billing — for LOCAL dev, copy to .env.local and fill in.
# firebase-functions v2 env layering:
#   .env.local — loaded ONLY by the Emulator Suite (never deployed) → put the
#                Stripe test keys here.
#   .env       — loaded on BOTH deploy and emulator → non-secret config only
#                (e.g. APP_URL). A key here that collides with a declared
#                secret fails the deploy.
# Leave everything unset and the API runs with billing disabled:
# GET /billing/config returns { enabled: false }, checkout/portal/webhook
# return 503 { error: "billing_disabled" }.
#
# Production keeps the two secrets in Secret Manager (bound via `secrets:` on
# the api function in src/api.ts):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Secret key (test mode: sk_test_…) — Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…). Local dev: printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…) for the two paid plans, monthly + annual, each a
# per-seat licensed recurring price. OPTIONAL — an explicit pin that overrides
# catalog discovery. Only STRIPE_SECRET_KEY is required for billing to be
# considered enabled; when these are unset the API resolves prices itself, in
# this order (15-min cache):
#   1. price lookup_key — studio_monthly / studio_annual / agency_monthly /
#      agency_annual. THE SUPPORTED WAY: unique per Stripe account, survives
#      product renames and price replacement. Assign them once per account
#      (test and live are separate catalogs) with:
#        STRIPE_SECRET_KEY=sk_… node stripe-setup.mjs           # inspect
#        STRIPE_SECRET_KEY=sk_… node stripe-setup.mjs --apply \
#          studio_monthly=price_… studio_annual=price_… \
#          agency_monthly=price_… agency_annual=price_…
#   2. product name/metadata guess ("Studio"/"Agency", or metadata
#      plan=studio|agency) — legacy fallback, ambiguous once a catalog has
#      more than one live price per plan+interval.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# Web-app origin. Checkout/Portal return URLs derive the calling app's https
# origin automatically (APP_URL, when set, overrides that). Still REQUIRED in
# prod for invite-email links — the Firestore trigger has no request to derive
# an origin from.
APP_URL=http://localhost:5173

# NOTE: outbound email needs no keys here — invite emails are queued as mail/
# docs and delivered by the firestore-send-email extension, whose SMTP config
# lives in firebase/extensions/firestore-send-email.env (+ its SMTP_PASSWORD
# secret in Secret Manager).
