# Stripe billing — for LOCAL dev, copy to .env.local and fill in.
# firebase-functions v2 env layering:
#   .env.local — loaded ONLY by the Emulator Suite (never deployed) → put the
#                Stripe test keys here.
#   .env       — loaded on BOTH deploy and emulator → non-secret config only
#                (e.g. APP_URL). A key here that collides with a declared
#                secret fails the deploy.
# Leave everything unset and the API runs with billing disabled:
# GET /billing/config returns { enabled: false }, checkout/portal/webhook
# return 503 { error: "billing_disabled" }.
#
# Production keeps the two secrets in Secret Manager (bound via `secrets:` on
# the api function in src/api.ts):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Secret key (test mode: sk_test_…) — Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…). Local dev: printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…) for the two paid products, monthly + annual, each a
# per-seat licensed recurring price. Optional: when unset, the API discovers
# active prices from the Stripe product catalog by product name/metadata
# ("Studio"/"Agency", or metadata plan=studio|agency) with a 15-min cache —
# only STRIPE_SECRET_KEY is required for billing to be considered enabled.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# Web-app origin. Checkout/Portal return URLs derive the calling app's https
# origin automatically (APP_URL, when set, overrides that). Still REQUIRED in
# prod for invite-email links — the Firestore trigger has no request to derive
# an origin from.
APP_URL=http://localhost:5173

# Resend Email — set RESEND_API_KEY to enable outbound transactional email.
# For production, prefer Secret Manager: firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pasdiu <info@pasdiu.com>
