# Stripe billing — copy to .env and fill in to enable billing.
# firebase-functions v2 loads functions/.env automatically, for BOTH the
# emulator and deploys (dotenv support). Leave everything unset and the API
# runs with billing disabled: GET /billing/config returns { enabled: false },
# checkout/portal/webhook return 503 { error: "billing_disabled" }.
#
# For production, prefer Secret Manager for the two secrets:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Secret key (test mode: sk_test_…) — Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…). Local dev: printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…) for the two paid products, monthly + annual, each a
# per-seat licensed recurring price. All four must be set (with the secret
# key) for billing to be considered enabled.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# Web-app origin used for Checkout/Portal redirect URLs.
APP_URL=http://localhost:5173

# Resend Email — set RESEND_API_KEY to enable outbound transactional email.
# For production, prefer Secret Manager: firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pasdiu <info@pasdiu.com>
