{
  "name": "pasdiu-functions",
  "description": "Cloud Functions API for the Pasdiu app",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "seed": "node seed.mjs",
    "grant-plan": "node grant-plan.mjs",
    "grant-plan:prod": "node grant-plan-prod.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "express": "^4.21.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
